{
  "name": "word-discover",
  "version": "2.0.1",
  "description": "一个基于网页的英语词汇学习工具，帮助您发现和掌握新单词。集成ECDICT 76万+词条数据库。",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/prepare-public.js",
    "dev": "npm run prebuild && vite",
    "build": "vite build && node scripts/postbuild.js",
    "preview": "vite preview",
    "test": "npx playwright test --reporter=list",
    "test:e2e": "npx playwright test tests/e2e-photosynthesis.spec.js --reporter=list",
    "prepare": "node scripts/install-hooks.js"
  },
  "keywords": [
    "vocabulary",
    "english",
    "learning",
    "education",
    "ecdict"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "pako": "^2.1.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "puppeteer": "^24.26.1",
    "terser": "^5.44.0",
    "vite": "^7.1.12",
    "vite-plugin-compression": "^0.5.1"
  }
}
