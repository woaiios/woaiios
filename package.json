{
  "name": "word-discover",
  "version": "2.0.1",
  "description": "一个基于网页的英语词汇学习工具，帮助您发现和掌握新单词。集成ECDICT 76万+词条数据库。",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/prepare-public.js",
    "dev": "npm run prebuild && vite",
    "build": "vite build && node scripts/postbuild.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "npx playwright test --reporter=list",
    "test:e2e": "npx playwright test tests/e2e-photosynthesis.spec.js --reporter=list",
    "test:song-ts": "npx playwright test tests/song-tailscale.spec.js --reporter=list",
    "test:unit": "vitest run",
    "prepare": "node scripts/install-hooks.js"
  },
  "keywords": [
    "vocabulary",
    "english",
    "learning",
    "education",
    "ecdict"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "pako": "^2.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "puppeteer": "^24.26.1",
    "terser": "^5.44.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.1.12",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.11"
  }
}
