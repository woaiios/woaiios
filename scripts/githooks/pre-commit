#!/bin/sh
 echo 'Running E2E tests before commit...'
 cmd //c npm run build
 if [ $? -ne 0 ]; then
   echo 'Build failed, commit aborted'
   exit 1
 fi
 cmd //c npx playwright test tests/e2e-photosynthesis.spec.js --reporter=list
 STATUS=$?
 if [ $STATUS -ne 0 ]; then
   echo 'E2E tests failed, commit aborted.'
   exit 1
 fi
# 歌曲生成门禁：必须真实产出 >60s 的音频（经 Tailscale 通道，杜绝浏览器内兜底）
# 紧急逃生：SKIP_SONG_GATE=1 git commit ... 可跳过（默认开启）
if [ -z "$SKIP_SONG_GATE" ]; then
  echo 'Running song Tailscale gate (歌曲必须真实生成且 >60s)...'
  cmd //c npx playwright test tests/song-tailscale.spec.js --reporter=list
  STATUS=$?
  if [ $STATUS -ne 0 ]; then
    echo 'Song gate failed (歌曲未生成 / 时长不足 60s), commit aborted.'
    exit 1
  fi
fi

 echo 'All checks passed, allowing commit'
 exit 0
