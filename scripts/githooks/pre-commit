#!/bin/sh
# 本地提交门禁（由 npm install / scripts/install-hooks 自动安装到 .git/hooks/pre-commit）
# 注意：此处不能用 `cmd //c`，在 Git Bash 下 `cmd //c` 不会真正执行后续命令，会导致门禁假绿灯。

echo 'Running build...'
npm run build
if [ $? -ne 0 ]; then
  echo 'Build failed, commit aborted'
  exit 1
fi

echo 'Running E2E smoke test...'
npx playwright test tests/e2e-photosynthesis.spec.js --reporter=list
if [ $? -ne 0 ]; then
  echo 'E2E tests failed, commit aborted.'
  exit 1
fi

# 歌曲生成门禁：默认暂停（ComfyUI 资源开销大，平时不启动）
# 启用：SONG_TESTS=1 git commit ...（测试 beforeAll 自动拉起 ComfyUI，afterAll 关闭释放内存）
if [ -n "$SONG_TESTS" ]; then
  echo 'Running song Tailscale gate (歌曲必须真实生成且 >4s)...'
  SONG_TESTS=1 npx playwright test tests/song-tailscale.spec.js --reporter=list
  if [ $? -ne 0 ]; then
    echo 'Song gate failed (歌曲未生成 / 时长不足 4s), commit aborted.'
    exit 1
  fi
fi

echo 'All checks passed, allowing commit'
exit 0
